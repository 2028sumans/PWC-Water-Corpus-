# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw scored-parcel JSON is 163 MB — over GitHub's 100 MB file limit. We ship
# the gzipped artifact (parcels_scored.json.gz, ~12 MB) and decompress in the
# browser via DecompressionStream. The raw .json is regenerated by
# preprocess_score_parcels.py and kept locally for dev.
public/data/parcels_scored.json

# Scored geojson is 454 MB — well over GitHub's 100 MB file limit. Only used
# locally as the tippecanoe input for re-baking public/tiles/parcels.pmtiles.
# Regeneratable in ~35s via /tmp/rebuild_scored_geojson.py (join Parcel.geojson
# geometry with parcels_scored.json attributes by GPIN), or in ~3 min via the
# full preprocess_score_parcels.py pipeline.
public/data/parcels_scored.geojson

# Raw source data for preprocess_score_parcels.py / bake_map_layers.py /
# build_rag_index.py — ~1.2 GB, never committed. Re-derived from the Water/
# export folder; see docs/ for the extraction recipe.
data/water_raw/
__pycache__/
