# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preprocess_score_parcels.py's output. Not shipped to the client — it's a
# local intermediate that build_facility_profiles.py reads for per-facility
# watershed/disclosure context (parcels_scored.json is not itself served by
# the Next.js app; only public/data/facility_profiles.json is).
public/data/parcels_scored.json
public/data/parcels_scored.geojson

# Raw source data for preprocess_score_parcels.py / build_facility_profiles.py /
# build_rag_index.py — ~1.2 GB, never committed. Re-derived from the Water/
# export folder; see docs/ for the extraction recipe.
data/water_raw/
__pycache__/
